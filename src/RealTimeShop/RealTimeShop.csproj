<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Use the licensed game's exact Mono API surface, without copying it to output. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ProbablyStolen.RealTimeShop</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion><FileVersion>2.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic><ContinuousIntegrationBuild>true</ContinuousIntegrationBuild><DebugType>none</DebugType><PathMap>$(MSBuildProjectDirectory)=/src/RealTimeShop</PathMap>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)/Probably Stolen_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/mscorlib.dll;$(ManagedDir)/netstandard.dll;$(ManagedDir)/System.dll;$(ManagedDir)/System.Core.dll;$(ManagedDir)/0Harmony.dll;$(ManagedDir)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Assembly-CSharp.dll;$(ManagedDir)/Assembly-CSharp-firstpass.dll;$(ManagedDir)/UnityEngine.AudioModule.dll;$(ManagedDir)/UnityEngine.UIModule.dll;$(ManagedDir)/Febucci.TextAnimator.Runtime.dll;$(ManagedDir)/Unity.Localization.dll;$(ManagedDir)/UnityEngine.CoreModule.dll;$(ManagedDir)/UnityEngine.IMGUIModule.dll;$(ManagedDir)/UnityEngine.InputLegacyModule.dll;$(ManagedDir)/UnityEngine.UI.dll;$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <None Include="manifest.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/Assembly-CSharp.dll')" Text="Set GameDir to the full game's Windows Mono installation, or supply ManagedDir. Demo IL2CPP references are incompatible. See README.md." />
  </Target>
</Project>

